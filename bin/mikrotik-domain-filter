#!/bin/bash

# @license: MIT License
# @author: SMKRV
# @github: https://github.com/smkrv/mikrotik-domain-filter-script
# @source: https://github.com/smkrv/mikrotik-domain-filter-script
#
# Filters and processes domain lists for Mikrotik RouterOS: downloads source
# lists, classifies domains (second-level / regional / other), applies a
# whitelist, validates domains via Cloudflare DoH, and publishes the results
# to output files and optionally to GitHub Gists. Suited for blocklists,
# allowlists, Adlists, DNS Static and DNS FWD entries.
#
# Detailed documentation:
# https://github.com/smkrv/mikrotik-domain-filter-script

# Enable debugging
# set -x

# Path settings
# Automatically determine working directory based on script location
# Declare and assign separately to avoid masking return values (SC2155)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
readonly REPO_DIR

# Installation replaces these defaults; shell WORK_DIR takes precedence.
INSTALL_VERSION=''
DEFAULT_WORK_DIR=''

# Version - read from VERSION file or use embedded version
if [[ -n "$INSTALL_VERSION" ]]; then
    VERSION="$INSTALL_VERSION"
elif [[ -f "${REPO_DIR}/VERSION" ]]; then
    VERSION="$(tr -d '[:space:]' < "${REPO_DIR}/VERSION")"
else
    VERSION="2.2.2"  # Fallback version
fi
readonly VERSION

# Default WORK_DIR to current directory or parent of bin/ if running from repo
if [[ -z "${WORK_DIR:-}" ]]; then
    if [[ -n "$DEFAULT_WORK_DIR" ]]; then
        WORK_DIR="$DEFAULT_WORK_DIR"
    elif [[ -d "${REPO_DIR}/config" ]]; then
        # Running from repository - use parent directory
        WORK_DIR="$REPO_DIR"
    else
        # Running standalone - use current directory
        WORK_DIR="$(pwd)"
    fi
fi
readonly WORK_DIR
readonly SOURCES_FILE="${WORK_DIR}/sources.txt"
readonly SOURCESSPECIAL_FILE="${WORK_DIR}/sources_special.txt"
readonly WHITELIST_FILE="${WORK_DIR}/sources_whitelist.txt"
readonly PUBLIC_SUFFIX_FILE="${WORK_DIR}/public_suffix_list.dat"
readonly LOG_FILE="${WORK_DIR}/script.log"
readonly LOG_MAX_BYTES=10485760

# Keep the lock inode outside temporary cleanup.
readonly LOCK_FILE="${WORK_DIR}/state/domains_update.lock"

# Temporary directories and files
readonly TMP_DIR="${WORK_DIR}/tmp"
readonly CACHE_DIR="${WORK_DIR}/cache"

# Output files
readonly OUTPUT_FILE="${WORK_DIR}/filtered_domains_mikrotik.txt"
readonly OUTPUT_FILESPECIAL="${WORK_DIR}/filtered_domains_special_mikrotik.txt"

# Read data assignments without evaluating shell syntax.
GIST_CONFIG_INVALID=false
declare -A ALLOWED_ENV_KEYS=(
    [EXPORT_GISTS]=1 [GITHUB_TOKEN]=1 [GIST_ID_MAIN]=1 [GIST_ID_SPECIAL]=1
    [MAX_PARALLEL_JOBS]=1 [DNS_TIMEOUT]=1 [DNS_MAX_RETRIES]=1 [DNS_MAX_FAILURE_PERCENT]=1
    [CACHE_TTL_DAYS]=1 [CACHE_INVALID_TTL_DAYS]=1
)
if [[ -f "${WORK_DIR}/.env" ]]; then
    while IFS= read -r env_line || [[ -n "$env_line" ]]; do
        env_line="${env_line%$'\r'}"
        env_line="${env_line#"${env_line%%[![:space:]]*}"}"
        [[ -z "$env_line" || "$env_line" == \#* ]] && continue
        if [[ "$env_line" != *=* ]]; then
            echo "WARNING: Ignoring malformed env assignment" >&2
            continue
        fi
        key="${env_line%%=*}"
        value="${env_line#*=}"
        key="${key%"${key##*[![:space:]]}"}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        if [[ ! "$key" =~ ^[A-Z_][A-Z0-9_]*$ || -z "${ALLOWED_ENV_KEYS[$key]:-}" ]]; then
            echo "WARNING: Ignoring unknown env key" >&2
            continue
        fi
        if [[ "$value" == \"* || "$value" == \'* ]]; then
            quote="${value:0:1}"
            if [[ ${#value} -lt 2 || "${value: -1}" != "$quote" ]]; then
                echo "WARNING: Ignoring unmatched quotes for $key" >&2
                [[ "$key" != GIST_ID_MAIN && "$key" != GIST_ID_SPECIAL ]] || GIST_CONFIG_INVALID=true
                continue
            fi
            value="${value:1:${#value}-2}"
        elif [[ "$value" == *\" || "$value" == *\' ]]; then
            echo "WARNING: Ignoring unmatched quotes for $key" >&2
            [[ "$key" != GIST_ID_MAIN && "$key" != GIST_ID_SPECIAL ]] || GIST_CONFIG_INVALID=true
            continue
        fi
        printf -v "$key" '%s' "$value"
    done < "${WORK_DIR}/.env"
    env_perms=$(stat -c %a "${WORK_DIR}/.env" 2>/dev/null || true)
    if [[ -n "$env_perms" && "$env_perms" != 600 && "$env_perms" != 400 ]]; then
        echo "WARNING: .env permissions should be 600 or 400" >&2
    fi
fi
# Validate both .env and shell settings before arithmetic or network calls.
for _env_var in DNS_TIMEOUT DNS_MAX_RETRIES DNS_MAX_FAILURE_PERCENT MAX_PARALLEL_JOBS CACHE_TTL_DAYS CACHE_INVALID_TTL_DAYS; do
    if [[ -n "${!_env_var:-}" && ! "${!_env_var}" =~ ^[1-9][0-9]{0,6}$ ]]; then
        echo "WARNING: Invalid numeric value for $_env_var, using default" >&2
        unset "$_env_var"
    fi
done
if [[ -n "${DNS_MAX_FAILURE_PERCENT:-}" ]] && (( DNS_MAX_FAILURE_PERCENT > 100 )); then
    echo "WARNING: Invalid numeric value for DNS_MAX_FAILURE_PERCENT, using default" >&2
    unset DNS_MAX_FAILURE_PERCENT
fi
if [[ -n "${MAX_PARALLEL_JOBS:-}" ]] && (( MAX_PARALLEL_JOBS > 64 )); then
    echo "WARNING: MAX_PARALLEL_JOBS exceeds 64, clamping to 64" >&2
    MAX_PARALLEL_JOBS=64
fi
for _env_var in GIST_ID_MAIN GIST_ID_SPECIAL; do
    if [[ -n "${!_env_var:-}" && ! "${!_env_var}" =~ ^[a-fA-F0-9]{20,32}$ ]]; then
        echo "WARNING: Invalid format for $_env_var; Gist export will fail if enabled" >&2
        GIST_CONFIG_INVALID=true
        unset "$_env_var"
    fi
done
if [[ -n "${EXPORT_GISTS:-}" && "$EXPORT_GISTS" != true && "$EXPORT_GISTS" != false ]]; then
    echo "WARNING: Invalid EXPORT_GISTS value, using false" >&2
    unset EXPORT_GISTS
fi
# An inherited export attribute survives assignment unless explicitly removed.
export -n GITHUB_TOKEN 2>/dev/null || true

# GitHub Gist settings !Use env var if available
readonly EXPORT_GISTS=${EXPORT_GISTS:-false}  # Default to false if not set
readonly GITHUB_TOKEN=${GITHUB_TOKEN:-""}     # GitHub access token
readonly GIST_ID_MAIN=${GIST_ID_MAIN:-""}     # Gist ID for main list
readonly GIST_ID_SPECIAL=${GIST_ID_SPECIAL:-""} # Gist ID for special list

# Add state preservation
readonly STATE_DIR="${WORK_DIR}/state"
readonly DNS_RETRY_FILE="${STATE_DIR}/dns_retry.pending"
DNS_RETRY_REQUIRED=false


# Performance settings (configurable via environment variables)
readonly MAX_PARALLEL_JOBS=${MAX_PARALLEL_JOBS:-5}
readonly DNS_MAX_FAILURE_PERCENT=${DNS_MAX_FAILURE_PERCENT:-5}

readonly DNS_TIMEOUT=${DNS_TIMEOUT:-10}
readonly DNS_MAX_RETRIES=${DNS_MAX_RETRIES:-3}

# Cache settings
readonly CACHE_TTL_DAYS=${CACHE_TTL_DAYS:-90}
readonly CACHE_INVALID_TTL_DAYS=${CACHE_INVALID_TTL_DAYS:-1}
readonly CACHE_INVALID_TTL_SECONDS=$((CACHE_INVALID_TTL_DAYS * 24 * 60 * 60))
readonly CACHE_TTL_SECONDS=$((CACHE_TTL_DAYS * 24 * 60 * 60))
readonly CACHE_MAX_SIZE_MB=1024

# Download limit for source lists and the Public Suffix List (100 MB).
# curl enforces it only when the server sends Content-Length.
readonly MAX_DOWNLOAD_BYTES=104857600

# Time thresholds
readonly PSL_UPDATE_DAYS=7
readonly FORCE_UPDATE_SECONDS=86400  # 24 hours

# Export variables for subshells
export DNS_TIMEOUT
export LOG_FILE
export DNS_MAX_RETRIES

# Enable debugging
# exec 2>"${WORK_DIR}/debug.log"

# Function to display help
show_help() {
    cat << EOF
Mikrotik Domain Filter Script v${VERSION}

USAGE:
    $(basename "$0") [OPTIONS]

DESCRIPTION:
    Filters and processes domain lists for Mikrotik RouterOS: classification,
    whitelist handling, DNS validation, optional GitHub Gist export.

OPTIONS:
    -h, --help      Show this help message and exit
    -v, --version   Show version information

CONFIGURATION:
    Working Directory: $WORK_DIR (auto-detected from script location)
    
    Required files:
    - sources.txt           Main domain list URLs
    - sources_special.txt   Special domain list URLs
    
    Optional files:
    - sources_whitelist.txt Whitelist domain URLs
    - .env                  Environment configuration

ENVIRONMENT VARIABLES:
    WORK_DIR                Override working directory (shell environment only,
                            not settable via .env)
    EXPORT_GISTS            Enable GitHub Gist exports (true/false)
    GITHUB_TOKEN            GitHub Personal Access Token
    GIST_ID_MAIN            Main list Gist ID
    GIST_ID_SPECIAL         Special list Gist ID
    MAX_PARALLEL_JOBS       Parallel DNS checks (default: 5)
    DNS_TIMEOUT             DNS query timeout in seconds (default: 10)
    DNS_MAX_RETRIES         DNS query retries (default: 3)
    DNS_MAX_FAILURE_PERCENT Maximum transient DNS failure percentage (default: 5)
    CACHE_TTL_DAYS          DNS cache TTL in days (default: 90)

For detailed documentation, visit:
https://github.com/smkrv/mikrotik-domain-filter-script

EOF
}

# Function to display version
show_version() {
    echo "Mikrotik Domain Filter Script v${VERSION}"
    echo "License: MIT"
    echo "Author: SMKRV"
    echo "Repository: https://github.com/smkrv/mikrotik-domain-filter-script"
}

# Parse command line arguments
parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done
}

# Check for required files
check_required_files() {
    local missing_files=()

    [[ ! -f "$SOURCES_FILE" ]] && missing_files+=("$SOURCES_FILE")
    [[ ! -f "$SOURCESSPECIAL_FILE" ]] && missing_files+=("$SOURCESSPECIAL_FILE")

    if [[ ${#missing_files[@]} -gt 0 ]]; then
        echo "ERROR: Missing required files:"
        printf '  - %s\n' "${missing_files[@]}"
        echo "Please create these files or copy from .example templates in the config/ directory"
        exit 1
    fi
    return 0
}

# Enhanced logging
log() {
    local timestamp
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] $1" | tee -a "$LOG_FILE"
}

error() {
    echo "ERROR: $1" >&2
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $1" >> "$LOG_FILE"
    exit 1
}

# Lock lifetime includes all background workers.
LOCK_HELD=false
acquire_lock() {
    local log_size=0
    exec 9>>"$LOCK_FILE" || return 1
    if ! flock -n 9; then
        echo "Script is already running (PID: $(cat "$LOCK_FILE" 2>/dev/null))" >&2
        exec 9>&-
        return 1
    fi
    if [[ -f "$LOG_FILE" ]]; then
        log_size=$(stat -c %s "$LOG_FILE" 2>/dev/null) || log_size=0
        if (( log_size > LOG_MAX_BYTES )) && ! mv -f -- "$LOG_FILE" "${LOG_FILE}.1"; then
            flock -u 9
            exec 9>&-
            return 1
        fi
    fi
    LOCK_HELD=true
    printf '%s\n' "$$" > "$LOCK_FILE"
    log "Lock acquired successfully"
}

stop_workers() {
    local roots pid children remaining attempt
    roots="$(jobs -pr) ${DNS_WORKER_PIDS[*]:-}"
    children="$roots"
    # Snapshot process IDs only; commands can contain credentials.
    for pid in $roots; do
        children+=" $(ps -eo pid=,ppid= | awk -v root="$pid" '
            {parent[$1]=$2}
            END {for (p in parent) {q=p; while (q in parent && q != root) q=parent[q]; if (q==root) print p}}')"
    done
    for pid in $children; do kill -TERM "$pid" 2>/dev/null || true; done
    for attempt in {1..40}; do
        remaining=false
        for pid in $children; do
            if ps -o stat= -p "$pid" 2>/dev/null | grep -q '^[[:space:]]*[^Z]'; then remaining=true; fi
        done
        [[ "$remaining" == true ]] || break
        sleep 0.05
    done
    for pid in $children; do kill -KILL "$pid" 2>/dev/null || true; done
    for pid in $roots; do wait "$pid" 2>/dev/null || true; done
    DNS_WORKER_PIDS=()
}

release_lock() {
    [[ "$LOCK_HELD" == true ]] || return 0
    stop_workers
    flock -u 9 2>/dev/null || true
    exec 9>&-
    LOCK_HELD=false
}

init_directories() {
    log "Initialization started..."

    if ! mkdir -p "$STATE_DIR"; then
        error "Failed to create state directory"
    fi

    if ! chmod 700 "$STATE_DIR"; then
        log "WARNING: Failed to set permissions for state directory"
    else
        log "State directory created with correct permissions"
    fi

    # Create state file if doesn't exist
    if [[ ! -f "${STATE_DIR}/update_state.dat" ]]; then
        if ! touch "${STATE_DIR}/update_state.dat"; then
            log "WARNING: Failed to create state file"
        fi
        if ! chmod 600 "${STATE_DIR}/update_state.dat"; then
            log "WARNING: Failed to set permissions for state file"
        fi
    fi

    # Check and create all required directories with proper permissions
    local dirs=("$WORK_DIR" "$TMP_DIR" "$CACHE_DIR" "$STATE_DIR" "${TMP_DIR}/downloads")
    for dir in "${dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            if ! mkdir -p "$dir"; then
                error "Failed to create directory ${dir}"
            fi
            # Owner-only permissions (rwx------)
            if ! chmod 700 "$dir"; then
                log "WARNING: Failed to set permissions for ${dir}"
            fi
        fi
        if [[ ! -w "$dir" ]]; then
            error "No write permissions for ${dir}"
        fi
    done

    # Ensure proper ownership
    if [[ -n "${SUDO_USER:-}" ]]; then
        if ! chown -R "$SUDO_USER:$SUDO_USER" "$TMP_DIR" "$STATE_DIR" "$CACHE_DIR"; then
            log "WARNING: Failed to set directory ownership"
        fi
    fi

    # Verify log file permissions
    if [[ ! -w "$(dirname "$LOG_FILE")" ]]; then
        error "No write permissions for log directory"
    fi

    if [[ -f "$LOG_FILE" && ! -w "$LOG_FILE" ]]; then
        error "No write permissions for log file"
    fi

    log "Initialization completed successfully"
    return 0
}

# Function to clean up temporary files
cleanup() {
    log "Starting cleanup..."

    # Validate directory paths
    for dir in "$TMP_DIR" "$CACHE_DIR"; do
        if [[ ! -d "$dir" ]]; then
            log "WARNING: Directory does not exist: $dir"
            continue
        fi
        if [[ "$dir" == "/" ]]; then
            log "ERROR: Invalid directory path: $dir"
            return 1
        fi
    done

    # Clean temporary directory
    if [[ -d "$TMP_DIR" && "$TMP_DIR" == "${WORK_DIR}/tmp"* ]]; then
        log "Cleaning temporary directory..."

        # Create list of protected files patterns
        local protected_patterns=(
            "*md5"
            "domain_registry.*"
            "previous_state.*"
            "update_state.dat"
            "*.backup"
        )

        # Remove files that don't match protected patterns
        local find_cmd=(find "$TMP_DIR" -type f)
        
        # Add exclusion patterns
        for pattern in "${protected_patterns[@]}"; do
            find_cmd+=("!" "-name" "$pattern")
        done
        
        find_cmd+=("-delete")

        # Execute find command safely
        if ! "${find_cmd[@]}" 2>/dev/null; then
            log "WARNING: Failed to clean temporary files"
        fi

        # Remove empty directories except protected ones
        find "$TMP_DIR" -type d -empty ! -name "downloads" ! -name "state" -delete 2>/dev/null || {
            log "WARNING: Failed to clean empty directories"
        }
    else
        log "WARNING: Invalid temporary directory path: $TMP_DIR"
        return 1
    fi

    # Clean old cache files
    if [[ -d "$CACHE_DIR" && "$CACHE_DIR" != "/" ]]; then
        log "Cleaning old cache files..."

        # Remove files older than CACHE_TTL_DAYS
        find "$CACHE_DIR" -type f -name "*.cache" -mtime +"$CACHE_TTL_DAYS" -delete 2>/dev/null || {
            log "WARNING: Failed to clean old cache files"
        }

        # Check cache size and clean if needed
        local cache_size
        cache_size=$(du -sm "$CACHE_DIR" 2>/dev/null | cut -f1)
        if [[ -n "$cache_size" ]] && (( cache_size > CACHE_MAX_SIZE_MB )); then
            log "Cache size exceeds ${CACHE_MAX_SIZE_MB}MB, cleaning oldest files..."
            find "$CACHE_DIR" -type f -name "*.cache" -exec stat --printf '%Y %n\0' {} + 2>/dev/null | \
                sort -z -n | head -z -n 1000 | cut -z -d' ' -f2- | xargs -0 -r rm -f -- 2>/dev/null || {
                log "WARNING: Failed to clean large cache"
            }
        fi
    fi

    log "Cleanup completed"
    return 0
}

cleanup_invalid_cache() {
    log "Cleaning invalid cache entries..."
    find "$CACHE_DIR" -type f -name "*.cache" -print0 | while IFS= read -r -d '' f; do
        if ! grep -qE "^(valid|nxdomain)$" "$f"; then
            rm -f "$f"
        fi
    done
}

log_cache_stats() {
    local total valid invalid
    # find -exec batches arguments; a glob here would exceed ARG_MAX on large caches
    total=$(find "$CACHE_DIR" -type f -name "*.cache" | wc -l)
    valid=$(find "$CACHE_DIR" -type f -name "*.cache" -exec grep -l "^valid$" {} + 2>/dev/null | wc -l)
    invalid=$(find "$CACHE_DIR" -type f -name "*.cache" -exec grep -l "^nxdomain$" {} + 2>/dev/null | wc -l)
    log "Cache stats - Total: $total, Valid: $valid, Invalid: $invalid"
}

# EXIT cleanup keeps the lock until every child has terminated.
trap_cleanup() {
    local exit_code=${1:-$?}
    trap - EXIT
    trap '' INT TERM
    if ! rollback_publication; then
        log "ERROR: Failed to restore previous outputs during cleanup"
        exit_code=1
    fi
    if [[ "$LOCK_HELD" == true ]]; then
        stop_workers
        cleanup || true
        release_lock
    fi
    exit "$exit_code"
}

# Keep authentication in a private header file, never in argv or child env.
github_api_request() {
    local method=$1 url=$2 data=${3:-} auth_file response rc=0
    auth_file=$(mktemp "${TMP_DIR}/auth.XXXXXX") || return 1
    chmod 600 "$auth_file" || { rm -f "$auth_file"; return 1; }
    printf 'Authorization: token %s\n' "$GITHUB_TOKEN" > "$auth_file"
    local args=(--silent --show-error --fail --connect-timeout 10 --max-time 30
        --proto '=https' -X "$method" -H "@$auth_file"
        -H "Accept: application/vnd.github.v3+json")
    [[ -z "$data" ]] || args+=(-H "Content-Type: application/json" -d "@$data")
    response=$(curl "${args[@]}" "$url") || rc=$?
    rm -f "$auth_file"
    [[ $rc -eq 0 ]] || return "$rc"
    printf '%s\n' "$response"
}

# Function to check dependencies
check_dependencies() {
    local deps=(curl jq awk grep sort flock find md5sum comm ps)
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            error "Required dependency: $dep"
        fi
    done
}

# Function to check domain via DNS
check_domain() {
    local domain=$1
    validate_domain "$domain" || return 1
    local cache_file="${CACHE_DIR}/${domain}.cache"
    local cache_time cache_status now ttl
    if [[ -f "$cache_file" ]]; then
        cache_status=$(<"$cache_file")
        ttl=$CACHE_TTL_SECONDS
        [[ "$cache_status" == nxdomain ]] && ttl=${CACHE_INVALID_TTL_SECONDS:-86400}
        if cache_time=$(stat -c %Y "$cache_file" 2>/dev/null); then
            now=$(date +%s)
            if (( now - cache_time < ttl )); then
                [[ "$cache_status" == valid ]] && return 0
                [[ "$cache_status" == nxdomain ]] && return 1
            fi
        fi
    fi
    local attempt response status
    for ((attempt=0; attempt<DNS_MAX_RETRIES; attempt++)); do
        (( attempt > 0 )) && sleep 2
        # NOERROR confirms existence, including suffix domains without apex A.
        if response=$(curl --connect-timeout "$DNS_TIMEOUT" --max-time "$DNS_TIMEOUT" -s -f \
            --header "accept: application/dns-json" \
            "https://cloudflare-dns.com/dns-query?name=${domain}&type=A"); then
            if status=$(jq -er '.Status | select(type == "number")' <<< "$response" 2>/dev/null); then
                case "$status" in
                    0) printf 'valid\n' > "$cache_file" || return 3; return 0 ;;
                    3) printf 'nxdomain\n' > "$cache_file" || return 3; return 1 ;;
                esac
            fi
        fi
    done
    return 2
}


# Function for parallel domain checking
check_domains_parallel() {
    local input=$1 output=$2
    [[ -r "$input" && -w "$(dirname "$output")" ]] || return 3
    local total results_dir worker_count worker pid rc failure=0 transient domain
    total=$(wc -l < "$input")
    (( total > 0 )) || return 1
    results_dir=$(mktemp -d "${TMP_DIR}/dns_results_XXXXXX") || return 3
    worker_count=$MAX_PARALLEL_JOBS
    (( worker_count > total )) && worker_count=$total
    log "Starting DNS checks: $total domains, $worker_count workers"
    # A shared file offset and a read lock distribute work as workers finish.
    exec 7< "$input" || return 3
    DNS_WORKER_PIDS=()
    for ((worker=0; worker<worker_count; worker++)); do
        (
            exec 8> "${results_dir}/queue.lock" || exit 3
            local domain result processed=0 worker_failure=0
            : > "${results_dir}/${worker}.valid" || exit 3
            : > "${results_dir}/${worker}.transient" || exit 3
            while true; do
                flock -x 8 || exit 3
                if ! IFS= read -r domain <&7; then
                    flock -u 8
                    break
                fi
                flock -u 8 || exit 3
                if check_domain "$domain"; then
                    printf '%s\n' "$domain" >> "${results_dir}/${worker}.valid" || exit 3
                else
                    result=$?
                    if (( result == 2 )); then
                        printf '%s\n' "$domain" >> "${results_dir}/${worker}.transient" || exit 3
                    elif (( result != 1 )); then
                        worker_failure=3
                    fi
                fi
                ((processed+=1))
                if [[ $((processed % 100)) -eq 0 ]]; then
                    log "DNS worker $worker processed $processed domains"
                fi
            done
            exit "$worker_failure"
        ) &
        DNS_WORKER_PIDS+=("$!")
    done
    exec 7<&-
    for pid in "${DNS_WORKER_PIDS[@]}"; do
        if wait "$pid"; then
            rc=0
        else
            rc=$?
        fi
        if (( rc != 0 )); then
            failure=3
        fi
    done
    DNS_WORKER_PIDS=()
    if (( failure == 0 )); then
        transient=$(awk 'END { print NR + 0 }' "${results_dir}/"*.transient)
        if (( transient * 100 > total * DNS_MAX_FAILURE_PERCENT )); then
            log "ERROR: DNS checks inconclusive: $transient of $total domains failed transiently (limit ${DNS_MAX_FAILURE_PERCENT}%)"
            failure=2
        elif (( transient > 0 )); then
            DNS_RETRY_REQUIRED=true
            # Persist before publication so unchanged inputs cannot skip retries.
            if ! : > "$DNS_RETRY_FILE"; then
                log "ERROR: Cannot record pending DNS retry"
                failure=3
            fi
            log "WARNING: Skipping $transient transient DNS failures; they were not cached and will be rechecked next run"
            while IFS= read -r domain; do
                log "WARNING: DNS check skipped (not cached): $domain"
            done < <(awk 'NR <= 10' "${results_dir}/"*.transient)
        fi
    fi
    if (( failure == 0 )); then
        if ! sort -u "${results_dir}/"*.valid > "${results_dir}/output"; then
            failure=3
        elif [[ ! -s "${results_dir}/output" ]]; then
            failure=1
        elif ! mv "${results_dir}/output" "$output"; then
            failure=3
        fi
    fi
    rm -f "${results_dir}/"*.valid "${results_dir}/"*.transient "${results_dir}/queue.lock" "${results_dir}/output"
    rmdir "$results_dir"
    if (( failure == 0 )); then
        log "DNS checks complete: $total processed, $(wc -l < "$output") valid"
    else
        log "DNS checks failed (status: $failure); output preserved"
    fi
    return "$failure"
}

# Function to load Public Suffix List
load_public_suffix_list() {
    if [[ -s "$PUBLIC_SUFFIX_FILE" ]] && ! find "$PUBLIC_SUFFIX_FILE" -mtime +"$PSL_UPDATE_DAYS" -print | grep -q .; then
        return 0
    fi
    log "Updating Public Suffix List..."
    local temp_psl filtered
    temp_psl=$(mktemp "${TMP_DIR}/psl.XXXXXX") || return 1
    filtered=$(mktemp "${TMP_DIR}/psl-filtered.XXXXXX") || { rm -f "$temp_psl"; return 1; }
    if curl --proto '=https' --proto-redir '=https' -fsSL --connect-timeout 10 --max-time 60 \
        --max-filesize "$MAX_DOWNLOAD_BYTES" "https://publicsuffix.org/list/public_suffix_list.dat" -o "$temp_psl" &&
       awk '
        { sub(/\r$/, "") }
        /^\/\// || /^$/ { next }
        /[[:space:]\/<>:;&"=]/ { bad=1; next }
        /^!/ { next }
        { print; count++ }
        END { if (bad || count==0) exit 1 }
       ' "$temp_psl" > "$filtered" && [[ -s "$filtered" ]] &&
       chmod 600 "$filtered" && mv "$filtered" "$PUBLIC_SUFFIX_FILE"; then
        rm -f "$temp_psl"
        log "Public Suffix List updated: $(wc -l < "$PUBLIC_SUFFIX_FILE") entries"
        return 0
    fi
    rm -f "$temp_psl" "$filtered"
    log "WARNING: Public Suffix List download or validation failed"
    [[ -s "$PUBLIC_SUFFIX_FILE" ]]
}

# Function to validate domain
validate_domain() {
    local domain=$1 label
    [[ ${#domain} -le 253 && "$domain" == *.* ]] || return 1
    [[ "$domain" =~ ^[a-zA-Z0-9.-]+$ ]] || return 1
    local tld=${domain##*.}
    [[ "$tld" =~ ^([a-zA-Z]{2,63}|[xX][nN]--[a-zA-Z0-9-]{1,59})$ ]] || return 1
    local -a labels
    IFS=. read -ra labels <<< "$domain"
    [[ "$domain" != *. ]] || return 1
    for label in "${labels[@]}"; do
        [[ ${#label} -ge 1 && ${#label} -le 63 ]] || return 1
        [[ "$label" != -* && "$label" != *- ]] || return 1
    done
}

# Function to extract domains from various formats
extract_domains() {
    local input=$1
    local output=$2
    local temp_output
    temp_output=$(mktemp "${TMP_DIR}/extracted_XXXXXX") || return 1

    log "Extracting domains from: $input"

    if ! [[ -f "$input" ]]; then
        log "ERROR: Input file does not exist: $input"
        return 1
    fi

    if ! [[ -r "$input" ]]; then
        log "ERROR: Cannot read input file: $input"
        return 1
    fi

    # Initialize temporary file with proper permissions
    if ! : > "$temp_output"; then
        log "ERROR: Failed to create temporary file"
        return 1
    fi

    if ! chmod 600 "$temp_output"; then
        log "WARNING: Failed to set permissions for temporary file"
    fi

    local processed=0
    local extracted=0

    while IFS= read -r line; do
        ((processed++)) || true

        # Skip empty lines and comments
        if [[ -z "$line" ]] || [[ "$line" =~ ^[[:space:]]*# ]]; then
            continue
        fi

        # Extract domain from different formats
        if [[ "$line" =~ ^[[:space:]]*-?[[:space:]]*(DOMAIN-SUFFIX|DOMAIN|DOMAIN-KEYWORD),(.+)$ ]]; then
            # Remove trailing comments and whitespace
            local domain="${BASH_REMATCH[2]%%#*}"
            domain=$(echo "$domain" | tr -d '[:space:]')

            if validate_domain "$domain"; then
                if ! echo "$domain" >> "$temp_output"; then
                    log "ERROR: Failed to write domain to temporary file"
                    rm -f "$temp_output"
                    return 1
                fi
                ((extracted++)) || true
            fi
        elif validate_domain "$line"; then
            if ! echo "$line" >> "$temp_output"; then
                log "ERROR: Failed to write domain to temporary file"
                rm -f "$temp_output"
                return 1
            fi
            ((extracted++)) || true
        fi

        # Progress logging for large files
        if [[ $((processed % 10000)) -eq 0 ]]; then
            log "Processed $processed lines, extracted $extracted domains"
        fi
    done < "$input"

    # Sort and deduplicate with error checking
    if ! sort -u "$temp_output" > "$output"; then
        log "ERROR: Failed to sort and deduplicate domains"
        rm -f "$temp_output"
        return 1
    fi

    rm -f "$temp_output"

    # Validate final output
    if ! [[ -s "$output" ]]; then
        log "WARNING: No domains were extracted"
        return 2
    fi

    local final_count
    final_count=$(wc -l < "$output")
    log "Extracted $final_count unique domains from $processed lines"

    return 0
}

# Function for initial filtering
initial_filter() {
    local input=$1
    local output=$2
    local temp_output
    temp_output=$(mktemp "${TMP_DIR}/filtered_XXXXXX")

    log "Initial filtering of: $input"

    if ! [[ -f "$input" ]]; then
        log "ERROR: Input file does not exist: $input"
        return 1
    fi

    if ! [[ -r "$input" ]]; then
        log "ERROR: Cannot read input file: $input"
        return 1
    fi

    # Create temporary file with proper permissions
    if ! : > "$temp_output"; then
        log "ERROR: Failed to create temporary file"
        return 1
    fi

    if ! chmod 600 "$temp_output"; then
        log "WARNING: Failed to set permissions for temporary file"
    fi

    if ! awk '
        {
            d=tolower($0)
            if (length(d)>253 || d !~ /^[a-z0-9.-]+$/) next
            n=split(d,a,"."); if(n<2) next
            t=a[n]
            if(t !~ /^[a-z]+$/ && t !~ /^xn--[a-z0-9-]+$/) next
            if(t !~ /^xn--/ && length(t)<2) next
            ok=1
            for(i=1;i<=n;i++) if(length(a[i])<1 || length(a[i])>63 || a[i] ~ /^-/ || a[i] ~ /-$/) ok=0
            if(ok) print d
        }
    ' "$input" > "$temp_output"; then
        rm -f "$temp_output"
        return 1
    fi

    # Sort and deduplicate with error checking
    if ! sort -u "$temp_output" > "$output"; then
        log "ERROR: Failed to sort and deduplicate domains"
        rm -f "$temp_output"
        return 1
    fi

    rm -f "$temp_output"

    # Validate results
    if ! [[ -s "$output" ]]; then
        log "ERROR: No domains passed initial filtering"
        return 1
    fi

    local total
    total=$(wc -l < "$output")
    log "Initially filtered domains: $total"

    return 0
}

# Function to process and classify domains
process_domains() {
    local input=$1 output_dir=$2 file
    [[ -r "$input" && -r "$PUBLIC_SUFFIX_FILE" ]] || return 1
    mkdir -p "$output_dir" || return 1
    for file in second regional other; do
        : > "${output_dir}/${file}.txt" || return 1
        chmod 600 "${output_dir}/${file}.txt" || return 1
    done
    # Classify parents first; hash lookups avoid per-domain subprocesses.
    if ! awk '{print split($0,a,"."),$0}' "$input" | sort -k1,1n -k2,2 | \
        awk -v psl="$PUBLIC_SUFFIX_FILE" -v dir="$output_dir" '
        BEGIN {while((getline line < psl)>0) suffix[line]=1; close(psl)}
        {
            n=$1; d=$2; split(d,a,".")
            covered=0; parent=d
            while(index(parent,".")) {
                sub(/^[^.]*\./,"",parent)
                if(parent in chosen) {covered=1; break}
            }
            if(covered || d in chosen) next
            base=a[n-1] "." a[n]
            if(n==2) kind="second"
            else if(n==3 && base in suffix) kind="regional"
            else kind="other"
            print d > (dir "/" kind ".txt")
            chosen[d]=1
        }
    '; then return 1; fi
    local count=0
    for file in second regional other; do
        sort -u "${output_dir}/${file}.txt" -o "${output_dir}/${file}.txt" || return 1
        ((count += $(wc -l < "${output_dir}/${file}.txt"))) || true
    done
    log "Classified domains: $count"
    (( count > 0 ))
}

# Function to prepare domains for DNS check
prepare_domains_for_dns_check() {
    local input_dir=$1
    local output=$2
    local temp_output="${output}.tmp"

    log "Preparing domains for DNS check..."

    if ! [[ -d "$input_dir" ]]; then
        log "ERROR: Input directory does not exist: $input_dir"
        return 1
    fi

    # Combine files with error checking
    if ! : > "$temp_output"; then
        log "ERROR: Failed to create temporary output file"
        return 1
    fi

    for file in "${input_dir}/second.txt" "${input_dir}/regional.txt" "${input_dir}/other.txt"; do
        if [[ -f "$file" ]]; then
            if ! cat "$file" >> "$temp_output"; then
                log "ERROR: Failed to append file: $file"
                rm -f "$temp_output"
                return 1
            fi
        fi
    done

    # Sort and deduplicate
    if ! sort -u "$temp_output" > "$output"; then
        log "ERROR: Failed to sort and deduplicate domains"
        rm -f "$temp_output"
        return 1
    fi

    rm -f "$temp_output"

    # Validate result
    if ! [[ -s "$output" ]]; then
        log "ERROR: No domains prepared for DNS check"
        return 1
    fi

    local total
    total=$(wc -l < "$output")
    log "Prepared $total domains for DNS check"

    return 0
}

# Function to apply whitelist
apply_whitelist() {
    local input=$1 whitelist=$2 output=$3 temp_output
    [[ -r "$input" && -r "$whitelist" && -r "$PUBLIC_SUFFIX_FILE" ]] || return 1
    temp_output=$(mktemp "${TMP_DIR}/whitelist_filtered_XXXXXX") || return 1
    if ! awk -v psl="$PUBLIC_SUFFIX_FILE" -v whitelist="$whitelist" '
        BEGIN {
            while((getline d < psl)>0) public[d]=1
            close(psl)
            while((getline d < whitelist)>0) {
                if(d=="") continue
                exact[d]=1; n=split(d,a,".")
                if(n==2 || (n==3 && (a[n-1] "." a[n]) in public)) suffix[d]=1
            }
            close(whitelist)
        }
        {
            if($0 in exact) next
            parent=$0; skip=0
            while(index(parent,".")) {
                sub(/^[^.]*\./,"",parent)
                if(parent in suffix) {skip=1; break}
            }
            if(!skip) print
        }
    ' "$input" > "$temp_output"; then
        rm -f "$temp_output"
        return 1
    fi
    mv "$temp_output" "$output"
}

# Function to check intersections between lists
check_intersections() {
    local main_list=$1
    local special_list=$2
    local temp_intersect="${TMP_DIR}/intersections.tmp"
    local temp_main="${TMP_DIR}/main_without_duplicates.tmp"

    log "Checking intersections between lists..."

    if ! [[ -f "$main_list" ]] || ! [[ -f "$special_list" ]]; then
        log "ERROR: One or both input files do not exist"
        return 1
    fi

    if ! [[ -s "$main_list" ]] || ! [[ -s "$special_list" ]]; then
        log "ERROR: One or both input files are empty"
        return 1
    fi

    # Create temporary files
    if ! : > "$temp_intersect" || ! : > "$temp_main"; then
        log "ERROR: Failed to create temporary files"
        return 1
    fi

    # Find intersections using comm
    if ! comm -12 <(sort "$main_list") <(sort "$special_list") > "$temp_intersect"; then
        log "ERROR: Failed to check intersections"
        rm -f "$temp_intersect" "$temp_main"
        return 1
    fi

    # If intersections found, remove them from main list
    if [[ -s "$temp_intersect" ]]; then
        log "Intersecting domains moved to special: $(wc -l < "$temp_intersect")"

        # Remove intersecting domains from main list (whole-line match:
        # without -x, example.com would also remove myexample.com)
        local grep_exit
        grep -vxFf "$temp_intersect" "$main_list" > "$temp_main" || {
            grep_exit=$?
            if [[ $grep_exit -eq 1 ]]; then
                log "WARNING: All main domains are in special list"
                : > "$temp_main"
            else
                log "ERROR: Failed to remove intersecting domains (grep exit code: $grep_exit)"
                rm -f "$temp_intersect" "$temp_main"
                return 1
            fi
        }

        # Update main list
        if ! mv "$temp_main" "$main_list"; then
            log "ERROR: Failed to update main list"
            rm -f "$temp_intersect" "$temp_main"
            return 1
        fi
    fi

    rm -f "$temp_intersect" "$temp_main"
    log "Intersection check completed - duplicates moved to special list"
    return 0
}

# Source downloads are retained for the current run and reused by load_lists.
declare -gA DOWNLOAD_STATUS=()
source_urls() {
    [[ -f "$1" ]] || return 1
    sed 's/#.*$//; s/^[[:space:]]*//; s/[[:space:]]*$//; /^$/d' "$1"
}

download_source() {
    local source=$1 path
    path="${TMP_DIR}/downloads/$(printf '%s' "$source" | md5sum | cut -d' ' -f1)"
    if [[ -n "${DOWNLOAD_STATUS[$source]:-}" ]]; then
        [[ "${DOWNLOAD_STATUS[$source]}" == ok ]]
        return
    fi
    DOWNLOAD_STATUS[$source]=failed
    [[ "$source" == https://* && ! "$source" =~ [[:space:]] ]] || {
        log "WARNING: Skipping invalid source URL"
        return 1
    }
    mkdir -p "${TMP_DIR}/downloads" || return 1
    if ! curl --proto '=https' --proto-redir '=https' -fsSL --connect-timeout 10 --max-time 30 \
        --retry 3 --retry-delay 2 --max-filesize "$MAX_DOWNLOAD_BYTES" "$source" -o "$path"; then
        log "WARNING: Failed to download $source"
        rm -f "$path"
        return 1
    fi
    [[ -s "$path" ]] || { log "WARNING: Empty source: $source"; return 1; }
    DOWNLOAD_STATUS[$source]=ok
}

load_lists() {
    local sources=$1 output=$2 source path configured=0 loaded=0
    [[ -f "$sources" ]] || return 1
    : > "$output" || return 1
    while IFS= read -r source; do
        ((configured+=1))
        if download_source "$source"; then
            path="${TMP_DIR}/downloads/$(printf '%s' "$source" | md5sum | cut -d' ' -f1)"
            # Strip comments while lines still retain their original boundaries.
            sed 's/#.*$//' "$path" | tr -s '[:space:]' '\n' | sed '/^$/d' >> "$output" || return 1
            ((loaded+=1))
        fi
    done < <(source_urls "$sources")
    if [[ "$sources" == "$WHITELIST_FILE" && $configured -eq 0 ]]; then
        log "Whitelist has no configured sources"
        return 0
    fi
    [[ $loaded -gt 0 ]] || { log "ERROR: No sources loaded successfully: $sources"; return 1; }
    # A partial whitelist would silently weaken configured policy.
    if [[ "$sources" == "$WHITELIST_FILE" && $loaded -ne $configured ]]; then
        log "ERROR: Configured whitelist source unavailable"
        return 1
    fi
}

# Validate once and normalize tolerated invalid rows in the staging files.
validate_results() {
    local main_list=$1 special_list=$2 file line invalid_count clean
    for file in "$main_list" "$special_list"; do
        [[ -s "$file" ]] || { log "ERROR: Missing or empty result: $file"; return 1; }
        clean=$(mktemp "${TMP_DIR}/validated.XXXXXX") || return 1
        invalid_count=0
        while IFS= read -r line || [[ -n "$line" ]]; do
            if validate_domain "$line"; then
                printf '%s\n' "$line" >> "$clean" || { rm -f "$clean"; return 1; }
            else
                log "WARNING: Invalid domain excluded: $line"
                ((invalid_count+=1))
                if (( invalid_count > 10 )); then rm -f "$clean"; return 1; fi
            fi
        done < "$file"
        # Publication separately rejects lists with no remaining valid rows.
        mv "$clean" "$file" || { rm -f "$clean"; return 1; }
    done
    log "Results validated"
}

PUBLICATION_IN_PROGRESS=false
PUBLICATION_HAD_MAIN=false
PUBLICATION_HAD_SPECIAL=false
PUBLICATION_STAGED_MAIN=''
PUBLICATION_STAGED_SPECIAL=''

rollback_publication() {
    [[ "$PUBLICATION_IN_PROGRESS" == true ]] || return 0
    local failed=0
    if [[ "$PUBLICATION_HAD_MAIN" == true ]]; then
        mv "${OUTPUT_FILE}.bak" "$OUTPUT_FILE" || failed=1
    else
        rm -f "$OUTPUT_FILE" || failed=1
    fi
    if [[ "$PUBLICATION_HAD_SPECIAL" == true ]]; then
        mv "${OUTPUT_FILESPECIAL}.bak" "$OUTPUT_FILESPECIAL" || failed=1
    else
        rm -f "$OUTPUT_FILESPECIAL" || failed=1
    fi
    rm -f "$PUBLICATION_STAGED_MAIN" "$PUBLICATION_STAGED_SPECIAL"
    PUBLICATION_IN_PROGRESS=false
    return "$failed"
}

# Publish only validated staging files, retaining the actual previous outputs.
save_results() {
    local main_list=$1 special_list=$2 staged_main staged_special
    [[ -s "$main_list" && -s "$special_list" ]] || return 1
    staged_main=$(mktemp "${WORK_DIR}/.main.XXXXXX") || return 1
    staged_special=$(mktemp "${WORK_DIR}/.special.XXXXXX") || { rm -f "$staged_main"; return 1; }
    if ! cp "$main_list" "$staged_main" || ! cp "$special_list" "$staged_special" || \
       ! chmod 600 "$staged_main" "$staged_special"; then
        rm -f "$staged_main" "$staged_special"
        return 1
    fi
    local file had_main=false had_special=false
    [[ ! -f "$OUTPUT_FILE" ]] || had_main=true
    [[ ! -f "$OUTPUT_FILESPECIAL" ]] || had_special=true
    for file in "$OUTPUT_FILE" "$OUTPUT_FILESPECIAL"; do
        if [[ -f "$file" ]]; then
            if ! cp "$file" "${file}.bak"; then
                rm -f "$staged_main" "$staged_special"
                return 1
            fi
        fi
    done
    PUBLICATION_HAD_MAIN=$had_main
    PUBLICATION_HAD_SPECIAL=$had_special
    PUBLICATION_STAGED_MAIN=$staged_main
    PUBLICATION_STAGED_SPECIAL=$staged_special
    PUBLICATION_IN_PROGRESS=true
    if ! mv "$staged_main" "$OUTPUT_FILE" || ! mv "$staged_special" "$OUTPUT_FILESPECIAL"; then
        rollback_publication || log "ERROR: Failed to restore previous outputs"
        return 1
    fi
    PUBLICATION_IN_PROGRESS=false
    rm -f "${OUTPUT_FILE}.bak" "${OUTPUT_FILESPECIAL}.bak"
    log "Results published successfully"
}

# Publish the staged lists before exposing local outputs or committing state.
update_gists() {
    [[ "$EXPORT_GISTS" == true ]] || return 0
    if [[ "$GIST_CONFIG_INVALID" == true ]]; then
        log "ERROR: Invalid configured Gist ID; no Gists were updated"
        return 1
    fi
    [[ -n "$GITHUB_TOKEN" && ( -n "$GIST_ID_MAIN" || -n "$GIST_ID_SPECIAL" ) ]] || {
        log "ERROR: Gist export requires a token and at least one Gist ID"
        return 1
    }
    local main_list=${1:-$OUTPUT_FILE} special_list=${2:-$OUTPUT_FILESPECIAL}
    local file id filename payload response
    for file in "$main_list" "$special_list"; do
        if [[ "$file" == "$main_list" ]]; then id=$GIST_ID_MAIN; filename=$(basename "$OUTPUT_FILE")
        else id=$GIST_ID_SPECIAL; filename=$(basename "$OUTPUT_FILESPECIAL"); fi
        if [[ -z "$id" ]]; then
            log "Skipping Gist update for $filename: no Gist ID configured"
            continue
        fi
        payload=$(mktemp "${TMP_DIR}/payload.XXXXXX") || return 1
        if ! jq -n --arg filename "$filename" --rawfile content "$file" \
            '{files: {($filename): {content: $content}}}' > "$payload"; then
            rm -f "$payload"
            return 1
        fi
        if ! response=$(github_api_request PATCH "https://api.github.com/gists/$id" "$payload"); then
            rm -f "$payload"
            log "ERROR: Gist request failed"
            return 1
        fi
        rm -f "$payload"
        if ! jq -e --arg id "$id" '.id == $id' <<< "$response" >/dev/null; then
            log "ERROR: Unexpected Gist response"
            return 1
        fi
    done
}

# Returns 0 for pending changes, 1 for unchanged, 2 for unavailable inputs.
check_updates_needed() {
    local current="${TMP_DIR}/downloads/current_md5"
    local previous="${TMP_DIR}/downloads/previous_md5"
    local source_file source path hash configured loaded role last_update
    mkdir -p "${TMP_DIR}/downloads" || return 2
    DOWNLOAD_STATUS=()
    : > "$current" || return 2
    for source_file in "$SOURCES_FILE" "$SOURCESSPECIAL_FILE" "$WHITELIST_FILE"; do
        [[ -f "$source_file" ]] || { [[ "$source_file" == "$WHITELIST_FILE" ]] && continue; return 2; }
        configured=0; loaded=0; role=$(basename "$source_file")
        while IFS= read -r source; do
            ((configured+=1))
            if download_source "$source"; then
                path="${TMP_DIR}/downloads/$(printf '%s' "$source" | md5sum | cut -d' ' -f1)"
                hash=$(md5sum "$path" | cut -d' ' -f1) || return 2
                printf '%s %s %s\n' "$role" "$source" "$hash" >> "$current" || return 2
                ((loaded+=1))
            else
                # Failed sources remain part of the manifest and are retried each run.
                printf '%s %s unavailable\n' "$role" "$source" >> "$current" || return 2
            fi
        done < <(source_urls "$source_file")
        if [[ "$source_file" == "$WHITELIST_FILE" ]]; then
            [[ $configured -eq $loaded ]] || return 2
        elif [[ $loaded -eq 0 ]]; then
            log "ERROR: No usable sources: $source_file"
            return 2
        fi
    done
    LC_ALL=C sort -u "$current" -o "$current" || return 2
    [[ ! -e "$DNS_RETRY_FILE" ]] || return 0
    [[ -s "$STATE_DIR/update_state.dat" && -s "$OUTPUT_FILE" && -s "$OUTPUT_FILESPECIAL" ]] || return 0
    [[ -f "$previous" ]] && cmp -s "$current" "$previous" || return 0
    last_update=$(<"$STATE_DIR/update_state.dat")
    [[ "$last_update" =~ ^[1-9][0-9]{0,10}$ ]] || return 0
    (( $(date +%s) - last_update <= FORCE_UPDATE_SECONDS )) || return 0
    return 1
}

commit_update_state() {
    local pending="${STATE_DIR}/update_state.pending"
    local previous="${TMP_DIR}/downloads/previous_md5"
    local backup="${TMP_DIR}/previous_state.timestamp"
    local had_state=false
    if [[ -f "${STATE_DIR}/update_state.dat" ]]; then
        cp "${STATE_DIR}/update_state.dat" "$backup" || return 1
        had_state=true
    fi
    date +%s > "$pending" && chmod 600 "$pending" || return 1
    cp "${TMP_DIR}/downloads/current_md5" "${previous}.pending" || return 1
    chmod 600 "${previous}.pending" || return 1
    # Timestamp first: a failed manifest move still compares against old inputs.
    mv "$pending" "${STATE_DIR}/update_state.dat" || return 1
    if ! mv "${previous}.pending" "$previous"; then
        if [[ "$had_state" == true ]]; then
            mv "$backup" "${STATE_DIR}/update_state.dat" || return 1
        else
            rm -f "${STATE_DIR}/update_state.dat"
        fi
        return 1
    fi
    if [[ "$DNS_RETRY_REQUIRED" != true ]]; then
        rm -f "$DNS_RETRY_FILE" || return 1
    fi
    rm -f "$backup"
}

# Function to process a single domain list
process_domain_list() {
    local list_name=$1
    local raw_file=$2
    local tmp_dir_prefix=$3
    
    log "Processing ${list_name} list..."
    
    # Extract domains
    if ! extract_domains "$raw_file" "${TMP_DIR}/${tmp_dir_prefix}_extracted.txt"; then
        log "ERROR: Failed to extract ${list_name} domains"
        return 1
    fi
    
    # Initial filtering on extracted output (not raw input)
    if ! initial_filter "${TMP_DIR}/${tmp_dir_prefix}_extracted.txt" "${TMP_DIR}/${tmp_dir_prefix}_initial.txt"; then
        log "ERROR: Failed to filter ${list_name} domains"
        return 1
    fi
    
    # Process and classify domains
    if ! process_domains "${TMP_DIR}/${tmp_dir_prefix}_initial.txt" "${TMP_DIR}/${tmp_dir_prefix}"; then
        log "ERROR: Failed to process ${list_name} domain list"
        return 1
    fi
    
    # Prepare domains for DNS check
    if ! prepare_domains_for_dns_check "${TMP_DIR}/${tmp_dir_prefix}" "${TMP_DIR}/${tmp_dir_prefix}_filtered.txt"; then
        log "ERROR: Failed to prepare ${list_name} domains for DNS check"
        return 1
    fi
    
    log "${list_name} list processing completed successfully"
    return 0
}

# Main function
main() {
    parse_arguments "$@"
    # Directory creation precedes locking; logging and state mutation follow it.
    mkdir -p "$STATE_DIR" "$TMP_DIR" || return 1
    chmod 700 "$STATE_DIR" "$TMP_DIR" || return 1
    acquire_lock || return 1
    DNS_RETRY_REQUIRED=false
    log "Script started..."
    if ! check_required_files || ! init_directories || ! check_dependencies || \
       ! cleanup || ! load_public_suffix_list; then
        release_lock
        return 1
    fi
    local update_rc=0
    check_updates_needed || update_rc=$?
    if [[ $update_rc -ne 0 ]]; then
        release_lock
        [[ $update_rc -eq 1 ]]
        return
    fi
    local main_raw="${TMP_DIR}/main_raw.txt" special_raw="${TMP_DIR}/special_raw.txt"
    local whitelist_raw="${TMP_DIR}/whitelist_raw.txt"
    if ! load_lists "$SOURCES_FILE" "$main_raw" || ! load_lists "$SOURCESSPECIAL_FILE" "$special_raw"; then
        release_lock
        return 1
    fi
    if [[ -f "$WHITELIST_FILE" ]] && ! load_lists "$WHITELIST_FILE" "$whitelist_raw"; then
        release_lock
        return 1
    fi
    if ! process_domain_list main "$main_raw" main || ! process_domain_list special "$special_raw" special; then
        release_lock
        return 1
    fi
    if [[ -s "$whitelist_raw" ]]; then
        # Empty parsed whitelist is permitted when downloads succeeded.
        local whitelist_rc=0
        extract_domains "$whitelist_raw" "${TMP_DIR}/whitelist_extracted.txt" || whitelist_rc=$?
        if [[ $whitelist_rc -ne 0 && $whitelist_rc -ne 2 ]]; then
            log "ERROR: Failed to extract whitelist"
            release_lock
            return 1
        fi
        if [[ -s "${TMP_DIR}/whitelist_extracted.txt" ]]; then
            if ! initial_filter "${TMP_DIR}/whitelist_extracted.txt" "${TMP_DIR}/whitelist.txt" || \
               ! apply_whitelist "${TMP_DIR}/main_filtered.txt" "${TMP_DIR}/whitelist.txt" "${TMP_DIR}/main_filtered_clean.txt" || \
               ! apply_whitelist "${TMP_DIR}/special_filtered.txt" "${TMP_DIR}/whitelist.txt" "${TMP_DIR}/special_filtered_clean.txt" || \
               ! mv "${TMP_DIR}/main_filtered_clean.txt" "${TMP_DIR}/main_filtered.txt" || \
               ! mv "${TMP_DIR}/special_filtered_clean.txt" "${TMP_DIR}/special_filtered.txt"; then
                release_lock
                return 1
            fi
        fi
    fi
    local staged_main="${TMP_DIR}/main_dns.txt" staged_special="${TMP_DIR}/special_dns.txt"
    if ! check_intersections "${TMP_DIR}/main_filtered.txt" "${TMP_DIR}/special_filtered.txt" || \
       ! check_domains_parallel "${TMP_DIR}/main_filtered.txt" "$staged_main" || \
       ! check_domains_parallel "${TMP_DIR}/special_filtered.txt" "$staged_special" || \
       ! validate_results "$staged_main" "$staged_special" || \
       [[ ! -s "$staged_main" || ! -s "$staged_special" ]] || \
       ! update_gists "$staged_main" "$staged_special" || \
       ! save_results "$staged_main" "$staged_special" || ! commit_update_state; then
        log "ERROR: Processing failed; update state remains pending"
        release_lock
        return 1
    fi
    cleanup || true
    log "Processing completed successfully"
    release_lock
}

# Sourcing provides functions without changing shell options or traps.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -e
    trap 'trap_cleanup $?' EXIT
    trap 'trap_cleanup 130' INT
    trap 'trap_cleanup 143' TERM
    if main "$@"; then exit 0; else exit 1; fi
fi
